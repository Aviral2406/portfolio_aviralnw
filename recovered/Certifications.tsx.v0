"use client";

import React, { useRef, useLayoutEffect } from "react";
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

const certifications = [
  {
    num: "CERT-01",
    title: "Introduction to Deep Learning",
    issuer: "Wingspan",
    issued: "January 10, 2026",
    category: "Deep Learning",
    description: "Completed foundational coursework covering deep learning concepts and neural-network fundamentals.",
    url: "https://verify.onwingspan.com",
  },
  {
    num: "CERT-02",
    title: "Introduction to Natural Language Processing",
    issuer: "Wingspan",
    issued: "January 10, 2026",
    category: "Natural Language Processing",
    description: "Completed introductory coursework in natural language processing concepts and applications.",
    url: "https://verify.onwingspan.com",
  },
  {
    num: "CERT-03",
    title: "Python Foundation Certification",
    issuer: "Wingspan",
    issued: "January 10, 2026",
    category: "Python",
    description: "Completed foundational certification covering Python programming concepts.",
    url: "https://verify.onwingspan.com",
  },
  {
    num: "CERT-04",
    title: "Artificial Intelligence Foundation Certification",
    issuer: "Wingspan",
    issued: "January 11, 2026",
    category: "Artificial Intelligence",
    description: "Completed foundational coursework in artificial intelligence concepts.",
    url: "https://verify.onwingspan.com",
  },
];

export default function Certifications() {
  const sectionRef = useRef<HTMLDivElement>(null);

  useLayoutEffect(() => {
    const ctx = gsap.context(() => {
      const items = gsap.utils.toArray<HTMLElement>(".cert-item");
      
      items.forEach((item) => {
        ScrollTrigger.create({
          trigger: item,
          start: "top bottom-=50",
          end: "bottom top",
          animation: gsap.fromTo(item, 
            { opacity: 0, y: 30 }, 
            { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" }
          ),
          toggleActions: "play none none reverse"
        });
      });
    }, sectionRef);

    return () => ctx.revert();
  }, []);

  return (
    <section id="certifications" ref={sectionRef} className="py-32 relative z-10 border-t border-[#14211a]">
      {/* Header */}
      <div className="flex flex-col mb-16">
        <div className="flex items-center gap-4 mb-6">
          <span className="font-mono text-[10px] tracking-widest text-[#656d4a]">05</span>
          <span className="w-12 h-[1px] bg-[#3c5d48]"></span>
          <span className="font-mono text-[10px] tracking-widest text-[#656d4a] uppercase">
            Foundational Learning · 2026
          </span>
        </div>
        <h2 className="font-serif text-4xl md:text-5xl text-[#f0f2eb]">Certifications</h2>
      </div>

      {/* Ledger Container */}
      <div className="relative border border-[#14211a] bg-[#080d0a]/80 overflow-hidden bg-grain">
        {/* Subtle Background Markings */}
        <div className="absolute inset-0 pointer-events-none opacity-20" style={{
          backgroundImage: "radial-gradient(circle at 100% 100%, #14211a 0%, transparent 40%), linear-gradient(0deg, transparent 95%, #14211a 100%)",
          backgroundSize: "100% 100%, 100% 40px"
        }} />
        <div className="absolute top-4 right-4 font-mono text-[8px] tracking-widest text-[#3c5d48]">
          SEC-05 // LOG
        </div>

        <div className="flex flex-col">
          {certifications.map((cert, idx) => (
            <div 
              key={cert.num} 
              className={`cert-item relative z-10 grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 p-8 transition-colors hover:bg-[#0d1611]/50 ${idx !== certifications.length - 1 ? "border-b border-[#14211a]" : ""}`}
            >
              {/* Left Column: Meta */}
              <div className="md:col-span-4 flex flex-col justify-start">
                <span className="font-mono text-[12px] tracking-widest text-[#f0f2eb] mb-2">{cert.num}</span>
                <span className="font-mono text-[10px] tracking-widest uppercase text-[#656d4a] mb-1">{cert.issued}</span>
                <span className="font-mono text-[9px] tracking-wider uppercase text-[#a3b18a] border border-[#2c4435] px-2 py-1 mt-4 self-start">
                  {cert.category}
                </span>
              </div>

              {/* Right Column: Details */}
              <div className="md:col-span-8 flex flex-col justify-start">
                <h3 className="font-serif text-2xl text-[#f0f2eb] mb-2">{cert.title}</h3>
                <span className="font-sans text-xs tracking-widest uppercase text-[#a3b18a] mb-4">Issuer: {cert.issuer}</span>
                <p className="text-[#8a998b] font-light leading-relaxed mb-6 text-sm md:text-base">
                  {cert.description}
                </p>
                <a 
                  href={cert.url} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  className="font-mono text-[10px] tracking-widest uppercase text-[#f0f2eb] border-b border-[#3c5d48] pb-1 hover:text-[#10b981] hover:border-[#10b981] transition-colors self-start flex items-center gap-1"
                >
                  Verify <span className="text-[8px]">↗</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  );
}