"use client";

import React, { useRef, useLayoutEffect } from "react";
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

const projects = [
  {
    num: "04.1",
    title: "Stock Market Predictor",
    description: "Deep learning pipeline utilizing LSTMs and GRUs for market movement forecasting based on historical time series data.",
    tags: ["Python", "TensorFlow", "Keras", "Pandas", "NumPy", "Matplotlib"],
    github: "https://github.com/Aviral2406/stock-market-predictor",
    codeSnippet: `model = Sequential([
    LSTM(64, return_sequences=True, input_shape=(X_train.shape[1], 1)),
    Dropout(0.2),
    GRU(64, return_sequences=False),
    Dropout(0.2),
    Dense(32, activation='relu'),
    Dense(1)
])
model.compile(optimizer='adam', loss='mean_squared_error')
model.fit(X_train, y_train, epochs=50, batch_size=32)`,
  },
  {
    num: "04.2",
    title: "Portfolio Optimizer",
    description: "Quantitative finance asset allocation algorithms modeled on Modern Portfolio Theory and Markowitz optimization for efficient frontier generation.",
    tags: ["Python", "SciPy", "Pandas", "Matplotlib", "yfinance"],
    github: "https://github.com/Aviral2406/portfolio-optimizer",
    codeSnippet: `def minimize_volatility(weights, cov):
    port_vol = np.sqrt(np.dot(weights.T, np.dot(cov * 252, weights)))
    return port_vol
    
constraints = ({'type': 'eq', 'fun': lambda x: np.sum(x) - 1})
bounds = tuple((0, 1) for _ in range(num_assets))
opt_results = sci_opt.minimize(minimize_volatility, 
                               init_guess, 
                               args=(cov_matrix,), 
                               method='SLSQP', 
                               bounds=bounds, 
                               constraints=constraints)`,
  }
];

export default function Projects() {
  const sectionRef = useRef<HTMLDivElement>(null);

  useLayoutEffect(() => {
    const ctx = gsap.context(() => {
      // Panel overlap and reveal animation
      const panels = gsap.utils.toArray<HTMLElement>(".project-panel");
      
      panels.forEach((panel, i) => {
        ScrollTrigger.create({
          trigger: panel,
          start: "top bottom-=100",
          end: "bottom top",
          animation: gsap.fromTo(panel, 
            { opacity: 0, y: 50 }, 
            { opacity: 1, y: 0, duration: 1, ease: "power3.out" }
          ),
          toggleActions: "play none none reverse"
        });
      });
    }, sectionRef);

    return () => ctx.revert();
  }, []);

  return (
    <section id="projects" ref={sectionRef} className="py-32 relative z-10">
      <div className="flex items-center gap-4 mb-20">
        <span className="font-mono text-[10px] tracking-widest text-[#656d4a]">04</span>
        <span className="w-12 h-[1px] bg-[#3c5d48]"></span>
        <h2 className="font-serif text-4xl md:text-5xl text-[#f0f2eb]">Selected Work</h2>
      </div>

      <div className="flex flex-col gap-24 md:gap-32">
        {projects.map((project, idx) => (
          <div 
            key={project.title} 
            className="project-panel group relative grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center"
          >
            {/* Left: Project Info */}
            <div className={`lg:col-span-5 flex flex-col ${idx % 2 === 1 ? 'lg:order-2' : ''}`}>
              <span className="font-mono text-[10px] tracking-widest text-[#656d4a] block mb-4">
                {project.num}
              </span>
              <h3 className="font-serif text-3xl text-[#f0f2eb] mb-4">
                {project.title}
              </h3>
              <p className="text-[#8a998b] font-light leading-relaxed mb-6">
                {project.description}
              </p>
              
              <div className="flex flex-wrap gap-2 mb-8">
                {project.tags.map(tag => (
                  <span key={tag} className="font-mono text-[9px] tracking-wider uppercase text-[#a3b18a] border border-[#2c4435] px-2 py-1">
                    {tag}
                  </span>
                ))}
              </div>

              <div className="flex items-center gap-6">
                <a 
                  href={project.github} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  className="font-mono text-[10px] tracking-widest uppercase text-[#f0f2eb] border-b border-[#3c5d48] pb-1 hover:text-[#10b981] hover:border-[#10b981] transition-colors"
                >
                  View Repository ↗
                </a>
              </div>
            </div>

            {/* Right: Technical Proof / Code Snippet */}
            <div className={`lg:col-span-7 w-full ${idx % 2 === 1 ? 'lg:order-1' : ''}`}>
              <div className="relative border border-[#14211a] bg-[#080d0a]/80 p-6 overflow-hidden">
                <div className="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-[#10b981]/20 to-transparent" />
                
                {/* Tech Frame Header */}
                <div className="flex items-center justify-between border-b border-[#14211a] pb-4 mb-4">
                  <div className="flex gap-1.5">
                    <div className="w-2 h-2 rounded-full bg-[#14211a]" />
                    <div className="w-2 h-2 rounded-full bg-[#14211a]" />
                    <div className="w-2 h-2 rounded-full bg-[#14211a]" />
                  </div>
                  <span className="font-mono text-[8px] tracking-widest text-[#3c5d48] uppercase">
                    Architecture Implementation
                  </span>
                </div>

                {/* Code Snippet */}
                <pre className="text-[10px] md:text-xs font-mono text-[#a3b18a] overflow-x-auto whitespace-pre leading-loose">
                  {project.codeSnippet}
                </pre>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  );
}